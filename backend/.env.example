# ── CIRS backend environment ───────────────────────────────────
# Copy to backend/.env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cybersecurity_irs
DB_CONNECTION_LIMIT=10
# Hosted MySQL usually requires TLS:
DB_SSL=false
DB_SSL_VERIFY=true

# Auth — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_USER_EXPIRY=7d
JWT_ANALYST_EXPIRY=8h

# Allowed dashboard origins (comma separated). The extension origin is always allowed.
CORS_ORIGINS=https://your-dashboard.vercel.app
TRUST_PROXY=true
SERVE_FRONTEND=true

# Threat intelligence (optional). Without keys CIRS runs heuristic-only scans.
THREAT_INTEL_ENABLED=true
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_MS=6000
THREAT_INTEL_CACHE_TTL_SECONDS=900
THREAT_INTEL_MIN_INTERVAL_MS=1200

# Abuse protection
SCAN_RATE_LIMIT_PER_MINUTE=30
REPORT_RATE_LIMIT_PER_HOUR=10
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MS=900000

# Demo accounts created by `npm run seed` (passwords optional; generated if empty)
SEED_ANALYST_EMAIL=analyst@cirs.local
SEED_ANALYST_NAME=CIRS Duty Analyst
SEED_ANALYST_PASSWORD=
SEED_USER_EMAIL=user@cirs.local
SEED_USER_NAME=CIRS Demo User
SEED_USER_PASSWORD=
